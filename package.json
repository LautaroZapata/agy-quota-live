{
  "name": "agy-quota-live",
  "version": "1.1.0",
  "description": "Real-time 2-line (or optional 3-line) status HUD for Antigravity CLI showing all /quota buckets and new models (Gemini 4 Neon/Hydrogen/Carbon/Argon, 3.8 Flash, Claude 5.5, GPT-OSS, Orchestrator) with live updates.",
  "main": "src/cli.js",
  "bin": {
    "agy-quota-live": "./src/cli.js"
  },
  "files": [
    "assets",
    "bin",
    "skills",
    "src",
    "hooks.json",
    "plugin.json",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node src/cli.js doctor",
    "config": "node src/cli.js config",
    "install-hud": "node src/cli.js install",
    "uninstall-hud": "node src/cli.js uninstall",
    "refresh": "node src/cli.js refresh",
    "test": "node --test test/quota-live.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LautaroZapata/agy-quota-live.git"
  },
  "homepage": "https://github.com/LautaroZapata/agy-quota-live#readme",
  "bugs": {
    "url": "https://github.com/LautaroZapata/agy-quota-live/issues"
  },
  "keywords": [
    "antigravity",
    "agy",
    "hud",
    "statusline",
    "quota",
    "gemini",
    "neon",
    "hydrogen",
    "carbon",
    "claude",
    "argon",
    "orchestrator"
  ],
  "author": "Lautaro Zapata",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
